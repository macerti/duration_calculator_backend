# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (MariaDB/MySQL) ---
# Local dev: whatever you run locally (e.g. XAMPP/MAMP MariaDB, or a Docker container).
# On cPanel: use the values from "MySQL Databases" — host is usually "localhost",
# and DB_USER/DB_NAME are prefixed with your cPanel username, e.g. myuser_auditdb.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Server ---
PORT=4000
NODE_ENV=development
